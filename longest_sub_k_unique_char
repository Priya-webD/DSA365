class Solution {
  public:
    int longestKSubstr(string &s, int k) {
        // code here
        unordered_map<char,int>  mp;
        int submax = 0;
        int i=0, j=0;
        
        while(j<s.length()){
            //calculations for calculating the count of unique characters
            mp[s[j]]++; // map me char at jth index ko count ++ kr do
            
            if(mp.size() < k){
                j++;
            } else if(mp.size() == k){
                //do calculations 
                //longest substring ko store kara lo 
                //by comparing current substring size with the maxsub
                submax =  max(submax, j-i+1);
                j++;
            } else {
                // (mp.size > k ) 
                //ith element ko left se remove krna shuru kr do
                //and agr koi charcter complete zero ho jaye to
                //usko map me se remove kr do
                while(mp.size() > k){
                    mp[s[i]]--;
                if(mp[s[i]] == 0)
                    mp.erase(s[i]);
                    i++;
                }
                j++;
            }
        }
        //base case handle if submax ==0 then return -1 rather than 0
        if (submax == 0)
         return -1;
        return submax;
    }
};